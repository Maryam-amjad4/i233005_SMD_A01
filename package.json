{
  "name": "flexpp",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^7.0.4",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.9",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "react-test-renderer": "^19.2.3"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check-imports.mjs && node scripts/check-hooks.mjs",
    "smoke": "node scripts/smoke-render.mjs",
    "persistence": "node scripts/persistence-check.mjs",
    "store": "node scripts/store-contract-check.mjs",
    "verify": "npm test && npm run check && npm run smoke && npm run persistence && npm run store",
    "fixtures": "node scripts/report-fixtures.mjs && node scripts/report-demo-figures.mjs",
    "figures": "node scripts/report-demo-figures.mjs",
    "package": "node scripts/package-submission.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "verify:packaged": "node scripts/verify-packaged-layout.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "private": true
}
